# ─────────────────────────────────────────────
# Sepaito.ai — Environment variables
# Copy this to .env and fill in real values
# ─────────────────────────────────────────────

# ⚠️  CRITICAL: Generate real secrets for production!
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
JWT_SECRET=

# Admin bootstrap email (first ADMIN user created by seed)
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com

# Email provider (Resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Sepaito <noreply@yourdomain.com>

# Payment provider (Robokassa)
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_TEST_MODE=1

# Public URLs (set to your real domain in production)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
