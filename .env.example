# --- shared ---
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# --- database ---
# pgbouncer (transaction pool) on 6432; raw postgres on 5432
DATABASE_URL=postgresql://sepaito:sepaito@localhost:6432/sepaito?schema=public&pgbouncer=true&connection_limit=1
DIRECT_DATABASE_URL=postgresql://sepaito:sepaito@localhost:5432/sepaito?schema=public

# --- redis ---
REDIS_URL=redis://localhost:6379

# --- auth ---
AUTH_SECRET=change-me-to-32+-bytes-of-base64
JWT_SECRET=change-me-to-32+-bytes-of-base64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- email (Resend) ---
RESEND_API_KEY=re_stub
EMAIL_FROM="Sepaito <noreply@sepaito.ai>"

# --- robokassa (stub for now) ---
ROBOKASSA_MERCHANT_LOGIN=demo
ROBOKASSA_PASSWORD_1=password1
ROBOKASSA_PASSWORD_2=password2
ROBOKASSA_TEST_MODE=1

# --- gRPC (subscription service for the IDE) ---
GRPC_BIND=0.0.0.0:50051

# --- admin bootstrap ---
ADMIN_BOOTSTRAP_EMAIL=adam@sepaito.ai
