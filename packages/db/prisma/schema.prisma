// Sepaito.ai database schema
// Postgres 18 via PgBouncer (transaction-pooled)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────
// Users & auth
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Locale {
  EN
  RU
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String?
  avatarUrl       String?
  locale          Locale    @default(EN)
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  defaultThemeId  String?
  defaultModelId  String?

  sessions        Session[]
  devices         Device[]
  apiKeys         ApiKey[]
  payments        Payment[]
  subscriptions   Subscription[]
  oauthAccounts   OAuthAccount[]
  providerKeys    ProviderApiKey[]
  verifyTokens    VerificationToken[]
  resetTokens     PasswordResetToken[]
  auditLogs       AuditLog[]

  @@index([role])
}

model OAuthAccount {
  id            String   @id @default(cuid())
  userId        String
  provider      String   // 'google' | 'github'
  providerId    String
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  refreshTokenHash String  @unique
  userAgent       String?
  ip              String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  name        String   // e.g. "AgentPanel Desktop · Win32"
  platform    String?  // 'darwin' | 'win32' | 'linux'
  installId   String   @unique // local device install uuid
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  purpose   String   // 'email-verify'
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// IDE app integration
// ─────────────────────────────────────────────

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  name        String   // user label, e.g. "AgentPanel on Win32"
  keyHash     String   @unique
  keyPrefix   String   // first 8 chars for display, e.g. "sep_live_xxxx"
  scopes      String[] @default([])
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// User-supplied LLM provider keys (stored encrypted at app layer)
model ProviderApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // 'openai' | 'anthropic' | 'google' | 'moonshot'
  ciphertext   String   // AES-GCM ciphertext, base64
  iv           String
  last4        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ─────────────────────────────────────────────
// Subscriptions & payments
// ─────────────────────────────────────────────

enum PlanCode {
  HOBBY
  PRO
  TEAM
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  ROBOKASSA_STUB
  ROBOKASSA
}

model Plan {
  id              String   @id @default(cuid())
  code            PlanCode @unique
  name            String
  description     String?
  priceMonthlyRub Int      // kopecks
  priceYearlyRub  Int      // kopecks
  features        String[] @default([])
  panesLimit      Int      @default(4)
  workspacesLimit Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  interval           BillingInterval    @default(MONTH)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])
  payments           Payment[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id              String          @id @default(cuid())
  userId          String
  subscriptionId  String?
  provider        PaymentProvider @default(ROBOKASSA_STUB)
  invoiceId       String          @unique // Robokassa InvId
  amountRub       Int             // kopecks
  currency        String          @default("RUB")
  status          PaymentStatus   @default(PENDING)
  description     String?
  metadata        Json?
  signatureValue  String?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorEmail String?
  action     String   // 'auth.signin', 'admin.user.update', 'payment.webhook', ...
  entityType String?
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
